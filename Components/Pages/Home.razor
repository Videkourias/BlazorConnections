@page "/"
@using BlazorConnections.Extensions
@inject INYTService _nytService

<PageTitle>BlazorConnections</PageTitle>

<MudPaper Height="85vh" Elevation="0">
    <MudContainer Class="pt-2">
        <MudContainer Class="d-flex gap-4 align-center">
            <MudText Class="title">Connections</MudText>
            <MudDatePicker Label="Game Date" @bind-Date="ConnectionDate" @bind-Date:after="SelectNewDate" IsDateDisabledFunc="@((DateTime dt)=>(dt < new DateTime(2023, 6, 12) || DateOnly.FromDateTime(dt) > DateOnly.FromDateTime(DateTime.Now.AddDays(1))))"/>
        </MudContainer>
    </MudContainer>
    <MudDivider DividerType="DividerType.Middle" Class="my-6"/>
 
    <MudContainer Class="d-flex flex-column justify-start align-center" Style="height: 60%"> 
        @if(Tiles.Count == 0)
        {
            <MudProgressCircular Indeterminate />
            if(ErrorFetchingConnection)
            {
                <MudText>Error fetching connection. Check logs</MudText>
            }
        } 
        else
        {
                @if(IsShowingResults)
                {
                    <MudButton Variant="Variant.Text" Class="rounded-pill" OnClick="() => IsShowingResults = false" EndIcon="@Icons.Material.Filled.Close" Style="align-self: flex-end;">Back to puzzle</MudButton>
                    <MudStack>
                        <MudText Typo="Typo.h1">@CompletionMessage</MudText>
                        <MudContainer style="max-width: 12em;">
                            <MudGrid Spacing="1" Justify="Justify.Center">
                                @foreach(var guess in Guesses)
                                {
                                    // Reconstruct words of guess (doesn't preserve order)
                                    List<Difficulty> difficulties = new();
                                    foreach(var tile in Tiles)
                                    {
                                        if((guess & tile.Id) == tile.Id)
                                        {
                                            difficulties.Add(tile.Difficulty);
                                        }
                                    }

                                    foreach(var difficulty in difficulties)
                                    {
                                        string style = "width: 2em; height:2em; background-color: " + difficulty switch
                                        {
                                            Difficulty.Yellow => "rgb(249, 223, 109)",
                                            Difficulty.Green => "rgb(160, 195, 90)",   
                                            Difficulty.Blue => "rgb(176, 196, 239)",
                                            Difficulty.Purple => "rgb(186, 129, 197)",
                                            _ => ""
                                        };
                                        <MudItem xs="3">
                                            <MudPaper Elevation="0" Style=@style>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                }
                            </MudGrid>
                        </MudContainer>
                    </MudStack>
                }
                else
                {            
                    <MudStack>
                        <MudContainer Class="d-flex justify-center align-center">
                            <h2>Create four groups of four!</h2>
                        </MudContainer>   
                        <MudGrid Spacing="3">
                            <MudPopover OverflowBehavior="OverflowBehavior.FlipNever" Open="@IsPopoverOpen" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.TopCenter" Class="pa-2 popoverHint" Square="false" DropShadow="false">
                                <p>@PopoverMessage</p>
                            </MudPopover>

                            @foreach(var difficulty in CompletedDifficulties) //Display already completed groups
                            {
                                var categoryName = CategoryTitles[difficulty];
                                string style = "background-color: " + difficulty switch
                                {
                                    Difficulty.Yellow => "rgb(249, 223, 109)",
                                    Difficulty.Green => "rgb(160, 195, 90)",   
                                    Difficulty.Blue => "rgb(176, 196, 239)",
                                    Difficulty.Purple => "rgb(186, 129, 197)",
                                    _ => ""
                                };
                                <MudItem xs="12" Style="height: 8em">
                                    <MudPaper Elevation="0" Class="rounded pa-4 d-flex justify-center align-center wordCard" Style=@style>
                                        <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                            <MudText Class="correctWordCategory nytArial">@categoryName</MudText>
                                            <MudStack Row Justify="Justify.Center" Spacing="1">
                                                <MudText Class="correctWord nytArial" Style="">@string.Join(',', Tiles.Where(x => x.Difficulty == difficulty).Select(x => x.Word).Order())</MudText>
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        
                            @foreach(var tile in Tiles.Where(x => !x.Completed)) //Display non-matched words
                            {
                                string paperClass = "rounded pa-4 d-flex justify-center align-center wordCard" 
                                                        + (MaxTilesSelected ? (tile.Selected ? " cursor-pointer" : "") : " cursor-pointer") //Determine if word has pointer cursor on hover
                                                        + (tile.Selected ? " selected" : ""); //Determine if word has selected stylings

                                <MudItem xs="3" Style="height: 8em">
                                    <MudPaper Elevation="0" Class="@paperClass" @onclick="() => SelectTile(tile)">
                                        <MudText Class="noSelect wordCardText nytArial">@tile.Word</MudText>
                                    </MudPaper>
                                </MudItem>
                            }
                            
                        </MudGrid>  
                        @if(!IsGameOver)
                        {
                            <MudContainer Class="d-flex flex-row justify-center align-end gap-1">
                            <MudText>Mistakes Remaining: </MudText>
                                @for(int i = 0; i < RemainingGuesses; i++)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Dark" Size="Size.Small"></MudIcon>
                                }
                            </MudContainer>
                        }
                        <MudContainer Class="d-flex flex-row justify-center align-start gap-2">
                            @if(IsGameOver)
                            {
                                <MudButton Variant="Variant.Outlined" Class="rounded-pill mud-border-black" OnClick="@(() => IsShowingResults = true)">View Results</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Class="rounded-pill mud-border-black" Disabled="IsSubmitting" OnClick="Shuffle">Shuffle</MudButton>
                                <MudButton Variant="Variant.Outlined" Class="rounded-pill" OnClick="DeselectAll" Disabled="(!AnyTilesSelected || IsGameOver)">Deselect All</MudButton>
                                <MudButton Variant="Variant.Filled" Class="rounded-pill" Disabled="(!MaxTilesSelected || IsSubmitting || CurrentSelectionAlreadyGuess)" OnClick="Submit">Submit</MudButton>
                            }
                        </MudContainer>  
                    </MudStack>
                }    
        }

    </MudContainer>
</MudPaper>

<style>
    .title{
        font-family: "nyt-karnakcondensed";
        font-size: 42px;
        font-weight: 700;
    }

    .wordCard{
        height: 100%;
        background-color: #efefe6;
        color: #121212; 
        transition: 0.2s all;
    }

    .wordCard.selected{
        background-color: #5a594e;
        color: #f8f8f8;
    }

    .wordCard .wordCardText{
        font-size: 20pt; 
        font-weight: 700;
        text-transform: uppercase;
    }


    .popoverHint{
        background-color: #1d1d1e;
        color: white;
    }

    .nytArial{
        font-family: "nyt-franklin", Arial;
    }

    .correctWord{
        font-weight: 500;
        font-size: 20px;
    }

    .correctWordCategory{
        font-weight: 700;
        font-size: 20px;
    }

    .noSelect {
        -webkit-touch-callout: none; /* iOS Safari */
        -webkit-user-select: none; /* Safari */
        -khtml-user-select: none; /* Konqueror HTML */
        -moz-user-select: none; /* Old versions of Firefox */
        -ms-user-select: none; /* Internet Explorer/Edge */
         user-select: none; /* Non-prefixed version, currently
                                    supported by Chrome, Edge, Opera and Firefox */
    }
</style>

@code{
    private List<Tile> Tiles { get; set; } = new(); 
    private List<int> Guesses { get; set; } = new();
    private List<Difficulty> CompletedDifficulties { get; set; } = new();
    private bool AnyTilesSelected => Tiles.Any(x => x.Selected);
    private bool MaxTilesSelected => Tiles.Where(x => x.Selected).Count() == 4;
    private bool IsGameOver => CompletedDifficulties.Count() == 4;
    private int RemainingGuesses { get; set; } = 4;
    private bool CurrentSelectionAlreadyGuess { get; set; }



    private DateTime? ConnectionDate { get; set; } = DateTime.Now;
    private string PopoverMessage {get; set; } = string.Empty;
    private bool IsPopoverOpen { get; set; }
    private bool IsSubmitting { get; set; }
    private bool IsShowingResults { get; set; }
    private Dictionary<Difficulty, string> CategoryTitles { get; set; } = new(); // Mapping of difficulty to title of difficulty
    private string CompletionMessage => RemainingGuesses switch
    {
        4 => "Perfect",
        3 => "Great",
        2 => "Solid",
        1 => "Phew",
        _ => "Next Time"
    };
    private bool ErrorFetchingConnection { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await FetchConnection(DateOnly.FromDateTime(DateTime.Now));
    }

    private async Task FetchConnection(DateOnly date)
    {
        NYTConnection connection = null!;
        try
        {
            ErrorFetchingConnection = false;
            connection = await _nytService.GetConnection(date);
        }
        catch(Exception)
        {
            ErrorFetchingConnection = true;
            return;
        }

        IEnumerable<Card> cards = connection.Categories.SelectMany(x => x.Cards);

        int count = 0;
        Tiles = cards.Select(x => new Tile
        {
            Id = 1 << count++,
            Word = x.Content,
            Difficulty = (Difficulty)connection.Categories.IndexOf(connection.Categories.First(y => y.Cards.Contains(x))) // Difficulty based on order of Categories list
        }).ToList();

        Tiles.Shuffle();

        CategoryTitles = connection.Categories.ToDictionary(x => (Difficulty)connection.Categories.IndexOf(x), x => x.Title);
    }

    private async Task SelectNewDate()
    {
        Tiles.Clear();
        Guesses.Clear();
        CompletedDifficulties.Clear();
        RemainingGuesses = 4;
        IsShowingResults = false;
        StateHasChanged();

        await FetchConnection(DateOnly.FromDateTime(ConnectionDate ?? DateTime.Now));
    }

    private async Task SelectTile(Tile tile)
    {
        CurrentSelectionAlreadyGuess = false; // Can only re-guess after changing options

        //Only allow selection if haven't reached max tile count already and not in game over state. 
        if((MaxTilesSelected && !tile.Selected) || IsGameOver)
        {
            return;
        }

        tile.Selected = !tile.Selected;
    }

    private void DeselectAll() => Tiles.ForEach(x => x.Selected = false);

    private void Shuffle() => Tiles.Shuffle();

    public async void Submit()
    {
        IsSubmitting = true;
        CurrentSelectionAlreadyGuess = true;
        var selectedTiles = Tiles.Where(x => x.Selected).ToList();


        // Verify if guess has already been guessed.
        int guess = selectedTiles.Select(x => x.Id).Aggregate((a, b) => a | b);

        if(Guesses.Contains(guess))
        {
            FlashHint("Already Guessed!");
            return;
        }

        Guesses.Add(guess);


        // Show user result of their guess
        var difficultyCounts = selectedTiles.GroupBy(x => x.Difficulty).Select(x => x.Count());
        
        if(difficultyCounts.Any(x => x == 4))
        {
            CompletedDifficulties.Add(selectedTiles.First().Difficulty);
            selectedTiles.ForEach(x => 
                {
                    x.Selected = false;
                    x.Completed = true;
                });

            if(IsGameOver)
            {
                FlashHint(CompletionMessage);

                await Task.Delay(500);
                
                IsShowingResults = true; 
            }

            IsSubmitting = false;
            return;
        }
        else if(difficultyCounts.Any(x => x == 3))
        {
            FlashHint("One Off!");
        }
        else
        {
            FlashHint("Incorrect");
        }


        RemainingGuesses--;

        // If game is lost
        if(RemainingGuesses == 0)
        {
            await Task.Delay(1000);

            //Deselect all words
            Tiles.ForEach(x => x.Selected = false);

            //Reveal answers
            foreach(var difficulty in Tiles.Where(x => !x.Completed).Select(x => x.Difficulty).Distinct().OrderByDescending(x => x))
            {
                CompletedDifficulties.Add(difficulty);
                Tiles.Where(x => x.Difficulty == difficulty).ToList().ForEach(x => x.Completed = true);
                StateHasChanged();
                await Task.Delay(2000);
            }

            // Switch to results screen
            IsShowingResults = true; 
            StateHasChanged();
        }

        IsSubmitting = false;
    }

    private async void FlashHint(string hintMessage)
    {
        PopoverMessage = hintMessage;
        IsPopoverOpen = true;

        await Task.Delay(3000);

        IsPopoverOpen = false;
        PopoverMessage = string.Empty;

        StateHasChanged();
    }


    internal sealed class Tile
    {
        public int Id { get; init; }
        public string Word { get; init; } = string.Empty;
        public Difficulty Difficulty { get; init; }
        public bool Selected { get; set; }
        public bool Completed  { get; set; }
    }
}